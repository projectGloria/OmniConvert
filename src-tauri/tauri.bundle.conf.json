{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/pandoc",
      "binaries/typst"
    ],
    "resources": {
      "resources/pdfium.dll": "pdfium.dll"
    },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": {
        "installMode": "perMachine",
        "compression": "lzma"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
