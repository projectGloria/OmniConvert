{
  "name": "omniconvert",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "tsc --noEmit && vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:web": "npm run build:wasm && tsc --noEmit && vite build --mode web",
    "preview": "vite preview",
    "preview:web": "vite preview --mode web",
    "typecheck": "tsc --noEmit",
    "check:loc": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-loc.ps1",
    "lint:rs": "cargo clippy --workspace --all-targets -- -D warnings",
    "test:rs": "cargo test --workspace",
    "test:e2e": "cargo test -p omniconvert --test e2e_routes -- --include-ignored",
    "verify": "npm run typecheck && npm run check:loc && npm run lint:rs && npm run test:rs",
    "tauri": "tauri",
    "bindings": "cargo test --workspace export_bindings",
    "tauri:build": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "sidecars": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-sidecars.ps1"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@floating-ui/react": "^0.27.20",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
